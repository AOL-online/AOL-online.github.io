---
// First screen: main call = next free intro talk; the course follows in CourseBand.
import { Picture } from 'astro:assets';
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';
import { formatDayLong, formatDayShort, formatTime, localDate, localTimeData } from '../lib/time';
import heroImage from '../assets/photos/hero_breathing.webp';
import IntroButton from './IntroButton.astro';

const intro = course.introTalks[0];
const tz = course.mainTimeZone;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const day = intro ? cap(formatDayLong(intro.start, tz)) : '';
const mainTime = intro ? `${formatTime(intro.start, tz)} ${course.mainTimeZoneLabel}` : '';
const mainDate = intro ? localDate(intro.start, tz) : '';
const cities = intro
  ? course.cities.map((c) => ({
      name: c.name,
      time: formatTime(intro.start, c.tz),
      // Show the day only when it differs from the announced day.
      day: localDate(intro.start, c.tz) !== mainDate ? formatDayShort(intro.start, c.tz) : '',
    }))
  : [];
---

<section class="relative isolate overflow-hidden bg-paper md:min-h-[36rem]" aria-labelledby="intro-title">
  <Picture
    src={heroImage}
    alt={t('intro.photoAlt')}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 768, 1080, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="aspect-[16/9] w-full object-cover object-[85%_50%] md:absolute md:inset-0 md:-z-10 md:aspect-auto md:h-full md:object-right"
  />
  <div
    aria-hidden="true"
    class="hidden md:absolute md:inset-0 md:-z-10 md:block md:bg-[linear-gradient(90deg,var(--color-paper)_0%,var(--color-paper)_40%,color-mix(in_oklab,var(--color-paper)_80%,transparent)_54%,transparent_74%)]"
  >
  </div>

  {
    intro && (
      <div class="container-site relative py-9 md:flex md:min-h-[inherit] md:items-center md:py-14">
        <div class="max-w-xl">
          <p class="text-sm font-bold uppercase tracking-wider text-accent-text">{t('intro.eyebrow')}</p>
          <h1 id="intro-title" class="mt-2 text-[length:var(--text-display)] font-extrabold leading-[1.05] tracking-tight">
            {intro.title}
          </h1>
          <p class="mt-4 text-[length:var(--text-lead)]">{t('intro.text')}</p>

          <p class="mt-6 text-xl font-extrabold sm:text-2xl">
            {day} · {mainTime}
          </p>
          <p class="mt-1 font-semibold text-muted">{t('intro.format')}</p>

          <div class="mt-5">
            <p class="sr-only">{t('intro.cities')}</p>
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="list">
              {cities.map((c) => (
                <li class="rounded-xl border border-line bg-paper/90 px-3 py-2 text-sm">
                  <span class="block text-muted">{c.name}</span>
                  <span class="font-bold tabular-nums">{c.time}</span>
                  {c.day && <span class="text-muted"> ({c.day})</span>}
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm" data-local-times={localTimeData([intro])} hidden>
              <span class="font-bold">{t('local.label')}:</span> <span data-local-out />
            </p>
          </div>

          <div class="mt-6">
            <IntroButton registration={intro.registration} />
          </div>
        </div>
      </div>
    )
  }
</section>
