---
import { Picture } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';
import { course } from '../data/course.ru';
import { formatDateRange, formatWeekdayRange, formatSessionTime } from '../lib/time';
import heroImage from '../assets/photos/hero_breathing.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const dates = `${formatDateRange(course.startDate, course.endDate, lang)} · ${formatWeekdayRange(course.startDate, course.endDate, lang)}`;

// Hero shows the first session in the first two zones of the table (e.g. CET and Moscow).
const first = course.sessions[0];
const time = first
  ? course.timeZoneTable
      .slice(0, 2)
      .map((z) => {
        const v = formatSessionTime(first, z.tz, lang);
        return v ? `${v} ${z.label}` : null;
      })
      .filter(Boolean)
      .join(' · ')
  : '';
const hasIntro = course.introTalks.length > 0;
---

<section class="relative isolate overflow-hidden bg-paper md:min-h-[34rem] lg:min-h-[38rem]">
  <Picture
    src={heroImage}
    alt={t('hero.photoAlt')}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 768, 1080, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="aspect-[16/10] w-full object-cover object-[85%_50%] md:absolute md:inset-0 md:-z-10 md:aspect-auto md:h-full md:object-right"
  />
  <!-- Desktop: white fade on the left keeps text readable over the photo -->
  <div
    aria-hidden="true"
    class="hidden md:absolute md:inset-0 md:-z-10 md:block md:bg-[linear-gradient(90deg,var(--color-paper)_0%,var(--color-paper)_38%,rgb(255_255_255/0.8)_52%,rgb(255_255_255/0)_72%)]"
  ></div>
  <div class="container-site relative py-10 md:flex md:min-h-[inherit] md:items-center md:py-16">
    <div class="max-w-xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-wider text-accent-text">{course.subtitle}</p>
      <h1 class="text-[length:var(--text-display)] font-extrabold leading-[1.05] tracking-tight text-ink">
        {course.title}
      </h1>
      <p class="mt-5 text-[length:var(--text-lead)] font-semibold text-ink">{t('hero.lead')}</p>
      <p class="mt-3 text-base text-ink/85 md:text-lg">{t('hero.text')}</p>

      <dl class="mt-7 grid gap-3 rounded-2xl border border-line bg-paper/90 p-5 text-sm sm:text-base md:bg-paper/80">
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-bold">{t('hero.dates.label')}:</dt>
          <dd>{dates}</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-bold">{t('hero.time.label')}:</dt>
          <dd>{time || t('time.tba')}</dd>
        </div>
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-bold">{t('hero.format.label')}:</dt>
          <dd>{t('hero.format.value')}</dd>
        </div>
      </dl>

      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href="#register" class="btn btn-primary text-lg">{t('cta.register')}</a>
        {
          hasIntro && (
            <a href="#intro" class="link font-semibold">
              {t('cta.tryFree')} →
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
