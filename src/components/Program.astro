---
// 4. «Из чего состоит программа?» — 4 items with round photos.
import type { ImageMetadata } from 'astro';
import { copy } from '../i18n/copy.ru';
import RoundPhoto from './RoundPhoto.astro';
import breathing from '../assets/photos/program-breathing.jpg';
import meditation from '../assets/photos/program-meditation.jpg';
import yoga from '../assets/photos/program-yoga.jpg';
import tips from '../assets/photos/program-tips.jpg';

const photos: Record<string, ImageMetadata> = { breathing, meditation, yoga, tips };
const c = copy.program;
---

<section class="bg-surface py-[var(--spacing-section)]" aria-labelledby="program-title">
  <div class="container-site">
    <h2 id="program-title" class="h2">{c.title}</h2>
    <ul class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        c.items.map((it) => (
          <li class="flex flex-col items-center text-center sm:items-start sm:text-left">
            <RoundPhoto src={photos[it.key]} alt={it.alt} class="size-40 sm:size-44" />
            <h3 class="mt-4 text-xl">{it.title}</h3>
            <p class="mt-2">{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
