---
// Intro-talk registration: external form link, or a stub until the URL is in the data file.
import { t } from '../i18n/ui';
import type { Registration } from '../data/types';

interface Props {
  registration: Registration;
}
const { registration: r } = Astro.props;
---

{
  r.kind === 'link' ? (
    <a href={r.url} target="_blank" rel="noopener" class="btn btn-primary text-lg" aria-label={`${t('cta.intro')} (${t('newTab')})`}>
      {t('cta.intro')}
    </a>
  ) : (
    <div>
      <span class="btn text-lg" aria-disabled="true">
        {t('cta.intro')}
      </span>
      <p class="mt-2 text-sm text-muted">{t('intro.soon')}</p>
    </div>
  )
}
