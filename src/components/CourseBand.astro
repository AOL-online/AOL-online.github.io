---
// 2. The course: «Счастье онлайн», dates, Moscow time, North America note, button to the countries.
import { t } from '../i18n/ui';
import { copy } from '../i18n/copy.ru';
import { course } from '../data/course.ru';
import { formatDateRange, formatWeekdayRange, formatTimeRange, sessionStart, localTimeData } from '../lib/time';
import ScriptTitle from './ScriptTitle.astro';

const tz = course.mainTimeZone;
const first = course.sessions[0];
const dates = `${formatDateRange(course.startDate, course.endDate)} · ${formatWeekdayRange(course.startDate, course.endDate)}`;
const time = first?.start
  ? t('course.time', { time: formatTimeRange(first.start, first.durationMin, tz), zone: course.mainTimeZoneLabel })
  : t('time.tba');

const notes = course.sessions.flatMap((s) =>
  (s.overrides ?? []).map((ov) => {
    const cities = course.cities.filter((c) => c.tz.startsWith(ov.zonePrefix));
    const fmt = (sess: typeof s) =>
      cities
        .map((c) => {
          const st = sessionStart(sess, c.tz);
          return st ? `${formatTimeRange(st, sess.durationMin, c.tz)} ${c.name}` : '';
        })
        .filter(Boolean)
        .join(' / ');
    const other = course.sessions.find((x) => x !== s);
    return t('course.na', { region: ov.region, fri: fmt(s), weekend: other ? fmt(other) : '' });
  }),
);
---

<section class="bg-surface py-[var(--spacing-section)]" aria-labelledby="course-title">
  <div class="container-site grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-center">
    <div>
      <p class="text-sm font-medium uppercase tracking-wider text-accent-text">{t('course.label')}</p>
      <ScriptTitle id="course-title" text={course.brandTitle} class="mt-2" />
      <p class="mt-4 text-xl font-medium">{course.title} <span class="text-muted">({course.subtitle})</span></p>
      <p class="mt-3 text-[length:var(--text-lead)]">{copy.course.lead}</p>
    </div>
    <div class="flex flex-col gap-3 rounded-3xl border border-line bg-paper p-6 sm:p-8">
      <p class="text-2xl font-medium">{dates}</p>
      <p class="text-lg">{time}</p>
      {notes.map((n) => <p class="text-sm text-muted">{n}</p>)}
      <p class="text-sm" data-local-times={localTimeData(course.sessions)} hidden>
        <span class="font-medium">{t('local.label')}:</span> <span data-local-out />
      </p>
      <div class="mt-2">
        <a href="#register" class="btn btn-primary text-lg">{t('cta.register')}</a>
      </div>
    </div>
  </div>
</section>
