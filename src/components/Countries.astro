---
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';

// Flags: src/assets/flags/<code>.svg (copied from the flag-icons package, MIT).
const flags = import.meta.glob<{ default: ImageMetadata }>('../assets/flags/*.svg', { eager: true });
const flagFor = (code: string) => flags[`../assets/flags/${code}.svg`]?.default;
---

<section id="register" class="bg-surface py-[var(--spacing-section)]" aria-labelledby="register-title">
  <div class="container-site">
    <div class="max-w-2xl">
      <h2 id="register-title" class="text-[length:var(--text-h2)] font-extrabold leading-tight tracking-tight">
        {t('countries.title')}
      </h2>
      <p class="mt-4 text-[length:var(--text-lead)]">{t('countries.text')}</p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        course.countries.map((c) => {
          const flag = flagFor(c.code);
          return (
            <li class="flex items-center gap-4 rounded-2xl border border-line bg-paper p-4 sm:p-5">
              {flag && (
                <img
                  src={flag.src}
                  alt=""
                  width="48"
                  height="36"
                  class="h-9 w-12 shrink-0 rounded-sm object-cover ring-1 ring-line"
                  loading="lazy"
                />
              )}
              <span class="flex-1 text-lg font-bold">{c.name}</span>
              <a
                href={c.url}
                target="_blank"
                rel="noopener"
                class="btn btn-secondary min-h-11 px-4 text-sm"
                aria-label={`${t('countries.button')}: ${c.name} (${t('countries.newTab')})`}
              >
                {t('countries.button')}
                <svg aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-8 max-w-2xl space-y-2 text-base">
      <p class="font-semibold">{t('countries.price')}</p>
      <p class="text-muted">{t('countries.hint')}</p>
    </div>
  </div>
</section>
