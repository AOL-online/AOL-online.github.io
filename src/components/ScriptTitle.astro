---
// Handwritten heading (Art of Living Script) with the brand orange underline. Use for 3–5 big headings only.
import { Image } from 'astro:assets';
import underline from '../assets/brand/underline.png';

interface Props {
  text: string;
  as?: 'h1' | 'h2';
  id?: string;
  /** 'display' for the first screen, 'script' elsewhere. */
  size?: 'display' | 'script';
  class?: string;
}
const { text, as: Tag = 'h2', id, size = 'script', class: cls = '' } = Astro.props;
const sizeClass = size === 'display' ? 'text-[length:var(--text-display)]' : 'text-[length:var(--text-script)]';
---

<Tag id={id} class:list={['script text-ink', sizeClass, cls]}>
  <span class="relative inline-block pb-[0.28em]">
    {text}
    <Image
      src={underline}
      alt=""
      aria-hidden="true"
      widths={[400, 800]}
      sizes="(min-width: 768px) 40rem, 90vw"
      class="pointer-events-none absolute bottom-0 left-0 h-[0.22em] w-full select-none object-fill"
    />
  </span>
</Tag>
