---
// Day, Moscow time, 7 cities, "your local time" and the registration button of the next intro talk.
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';
import type { IntroTalk } from '../data/types';
import { formatDayLong, formatDayShort, formatTime, localDate, localTimeData } from '../lib/time';
import IntroButton from './IntroButton.astro';

interface Props {
  intro: IntroTalk;
  compact?: boolean;
}
const { intro, compact = false } = Astro.props;
const tz = course.mainTimeZone;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const day = cap(formatDayLong(intro.start, tz));
const mainTime = `${formatTime(intro.start, tz)} ${course.mainTimeZoneLabel}`;
const mainDate = localDate(intro.start, tz);
const cities = course.cities.map((c) => ({
  name: c.name,
  time: formatTime(intro.start, c.tz),
  day: localDate(intro.start, c.tz) !== mainDate ? formatDayShort(intro.start, c.tz) : '',
}));
---

<div>
  <p class="text-xl font-medium sm:text-2xl">{day} · {mainTime}</p>
  <p class="mt-1 text-muted">{t('intro.format')}</p>
  {
    !compact && (
      <div class="mt-5">
        <p class="sr-only">{t('intro.cities')}</p>
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="list">
          {cities.map((c) => (
            <li class="rounded-xl border border-line px-3 py-2 text-sm">
              <span class="block text-muted">{c.name}</span>
              <span class="font-medium tabular-nums">{c.time}</span>
              {c.day && <span class="text-muted"> ({c.day})</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <p class="mt-3 text-sm" data-local-times={localTimeData([intro])} hidden>
    <span class="font-medium">{t('local.label')}:</span> <span data-local-out />
  </p>
  <div class="mt-6">
    <IntroButton registration={intro.registration} />
  </div>
</div>
