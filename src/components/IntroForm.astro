---
// Embedded intro-talk registration form (only when registration.kind === 'embed').
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';

const intro = course.introTalks[0];
const r = intro?.registration;
---

{
  r && r.kind === 'embed' && (
    <section id="intro-form" class="bg-paper py-[var(--spacing-section)]" aria-labelledby="intro-form-title">
      <div class="container-site max-w-3xl">
        <h2 id="intro-form-title" class="text-[length:var(--text-h2)] font-extrabold leading-tight">
          {t('intro.form.title')}
        </h2>
        <iframe
          src={r.url}
          title={t('intro.form.title')}
          loading="lazy"
          class="mt-6 w-full rounded-2xl border border-line bg-paper"
          style={`height:${r.height ?? 900}px`}
        />
        <p class="mt-3 text-sm">
          <a class="link" href={r.url} target="_blank" rel="noopener">
            {t('intro.form.fallback')}
          </a>
        </p>
      </div>
    </section>
  )
}
