---
// 10. Teachers: round photo (or placeholder), name, place. Photos/contacts later, only with consent.
import type { ImageMetadata } from 'astro';
import { copy } from '../i18n/copy.ru';
import { course } from '../data/course.ru';
import RoundPhoto from './RoundPhoto.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/teachers/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (file?: string) => (file ? photos[`../assets/teachers/${file}`]?.default : undefined);
const c = copy.teachers;
---

<section class="bg-surface py-[var(--spacing-section)]" aria-labelledby="teachers-title">
  <div class="container-site">
    <h2 id="teachers-title" class="h2">{c.title}</h2>
    <p class="mt-4">{c.text}</p>
    <ul class="mt-10 grid gap-10 sm:grid-cols-3" role="list">
      {
        course.teachers.map((tch) => (
          <li class="flex flex-col items-center text-center">
            <RoundPhoto src={photoFor(tch.photo)} alt={tch.name} placeholder={tch.name.charAt(0)} class="size-40" />
            <p class="mt-4 text-xl font-medium">{tch.name}</p>
            <p class="text-muted">{tch.place}</p>
            <p class="mt-1 text-sm">{tch.role}</p>
            {tch.bio && <p class="mt-3">{tch.bio}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
