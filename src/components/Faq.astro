---
// 13. FAQ — native <details>, works without JS.
import { copy } from '../i18n/copy.ru';
const c = copy.faq;
---

<section class="bg-paper py-[var(--spacing-section)]" aria-labelledby="faq-title">
  <div class="container-site max-w-4xl">
    <h2 id="faq-title" class="h2">{c.title}</h2>
    <div class="mt-8 divide-y divide-line border-y border-line">
      {
        c.items.map((it) => (
          <details class="faq group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium">
              {it.q}
              <span class="text-2xl text-accent-text transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3">{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
