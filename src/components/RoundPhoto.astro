---
// Round photo with the brand hand-drawn circle (brandbook «кружочки»).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import circle from '../assets/brand/circle.png';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** Text inside the circle when there is no photo (e.g. initial). */
  placeholder?: string;
  class?: string;
}
const { src, alt = '', placeholder = '', class: cls = 'size-40' } = Astro.props;
---

<div class:list={['relative shrink-0', cls]}>
  {
    src ? (
      <Image src={src} alt={alt} widths={[240, 480]} sizes="12rem" class="absolute inset-[7%] size-[86%] rounded-full object-cover" />
    ) : (
      <div class="absolute inset-[7%] flex items-center justify-center rounded-full bg-surface" aria-hidden="true">
        <span class="script text-6xl text-muted">{placeholder}</span>
      </div>
    )
  }
  <Image src={circle} alt="" aria-hidden="true" widths={[240, 480]} sizes="12rem" class="pointer-events-none absolute inset-0 size-full select-none" />
</div>
