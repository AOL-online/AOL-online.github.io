---
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';
import { url } from '../lib/url';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/85">
  <div class="container-site flex h-16 items-center justify-between gap-2 sm:gap-3">
    <a href={url()} class="group flex min-w-0 flex-col leading-tight no-underline">
      <span class="truncate text-base font-extrabold tracking-tight text-ink group-hover:text-accent-text sm:text-lg">{course.title}</span>
      <span class="truncate text-xs font-semibold text-muted">{t('header.brand.sub')}</span>
    </a>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        class="js-only inline-flex size-11 items-center justify-center rounded-full border border-line text-ink hover:border-accent-text hover:text-accent-text"
        aria-label={t('theme.toDark')}
        data-label-dark={t('theme.toDark')}
        data-label-light={t('theme.toLight')}
      >
        <!-- moon: shown in light theme -->
        <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <!-- sun: shown in dark theme -->
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <a href="#register" class="btn btn-primary min-h-11 px-4 text-sm sm:px-5">{t('header.cta')}</a>
    </div>
  </div>
</header>

<style>
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.getAttribute('data-theme') ?? (media.matches ? 'dark' : 'light');
  const sync = () => {
    if (!btn) return;
    const dark = current() === 'dark';
    btn.setAttribute('aria-label', (dark ? btn.dataset.labelLight : btn.dataset.labelDark) ?? '');
  };
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked: the choice lasts until the page is closed */
    }
    sync();
  });
  media.addEventListener('change', sync);
  sync();
</script>
