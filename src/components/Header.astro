---
import { t } from '../i18n/ui';
import { course } from '../data/course.ru';
import { url } from '../lib/url';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/85">
  <div class="container-site flex h-16 items-center justify-between gap-2 sm:gap-3">
    <a href={url()} class="flex min-w-0 items-center gap-3 no-underline" aria-label={`The Art of Living · ${course.brandTitle}`}>
      <Logo variant="compact" class="h-10" />
      <span class="hidden border-l border-line pl-3 leading-tight sm:block">
        <span class="block text-base font-medium text-ink">{course.brandTitle}</span>
        <span class="block text-xs text-muted">{t('header.brand.sub')}</span>
      </span>
    </a>
    <div class="flex shrink-0 items-center gap-2">
      <a href="#register" class="btn btn-primary min-h-11 px-4 text-sm sm:px-5">{t('header.cta')}</a>
    </div>
  </div>
</header>
