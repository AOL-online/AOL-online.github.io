---
// 6. Sudarshan Kriya — slate blue block with benefits and the research PDF.
import { Image } from 'astro:assets';
import { copy, RESEARCH_PDF } from '../i18n/copy.ru';
import { url } from '../lib/url';
import lake from '../assets/photos/kriya-lake.jpg';
const c = copy.kriya;
---

<section class="on-slate py-[var(--spacing-section)]" aria-labelledby="kriya-title">
  <div class="container-site grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-center">
    <div>
      <h2 id="kriya-title" class="h2">{c.title}</h2>
      <p class="mt-5 text-[length:var(--text-lead)]">{c.text}</p>
      <h3 class="mt-8 text-xl">{c.listTitle}:</h3>
      <ul class="mt-3 space-y-2" role="list">
        {
          c.list.map((li) => (
            <li class="flex gap-3">
              <span class="mt-2.5 size-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{li}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-muted">{c.note}</p>
      <div class="mt-7">
        <a href={url(RESEARCH_PDF)} class="btn btn-primary" download>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          {c.pdf}
        </a>
        <p class="mt-2 text-sm text-muted">{c.pdfSize}</p>
      </div>
    </div>
    <Image src={lake} alt={c.photoAlt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-[2rem] object-cover" />
  </div>
</section>
